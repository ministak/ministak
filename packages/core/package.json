{
  "name": "ministak",
  "version": "0.2.2",
  "description": "轻量的 Vue 全栈框架：客户端 SPA、Fastify 服务端与 Server Action",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ministak",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ministak": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "fastify": "^5.10.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "fastify": "^5.10.0",
    "vite": "^8.1.5",
    "vue": "^3.5.40"
  }
}
